# Server configuration
PROJECT_NAME="ToolsHub Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"
BASE_URL="http://localhost:8000"

# CORS configuration (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8080"

# Database (defaults to SQLite; use postgresql://user:pass@localhost:5432/toolshub in production)
DATABASE_URL="sqlite:///./toolshub.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
USE_CELERY=false

# Storage & Temporary files
STORAGE_DIR="./storage/temp"
MAX_FILE_SIZE_MB=20
FILE_TTL_HOURS=1
